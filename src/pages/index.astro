---
import Base from '../layouts/Base.astro';
import { site } from '../site';
const hasVideo = site.showreelVideo && site.showreelVideo.length > 0;
---

<Base>
  <a class="gate" href="/works/" aria-label="작품 목록으로 입장">
    {hasVideo ? (
      <video
        class="gate-media"
        autoplay muted loop playsinline preload="auto"
        poster={site.showreelPoster || undefined}
      >
        <source src={site.showreelVideo} type="video/mp4" />
      </video>
    ) : (
      <div class="gate-media gate-fallback" aria-hidden="true"></div>
    )}

    <div class="gate-scrim"></div>

    <header class="gate-top">
      <span class="gate-mark">{site.directorLatin}</span>
      <span class="meta gate-kind">Showreel</span>
    </header>

    <div class="gate-body">
      <h1 class="gate-name">{site.director}</h1>
      <p class="gate-line">{site.tagline}</p>
      <span class="gate-enter">
        작품 보기 <span class="gate-arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</Base>

<style>
  .gate {
    position: relative;
    display: block;
    height: 100svh;
    min-height: 32rem;
    width: 100%;
    overflow: hidden;
    cursor: pointer;
  }

  .gate-media {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: gate-fade 2.4s ease 0.3s forwards;
  }
  .gate-fallback {
    background:
      radial-gradient(120% 90% at 50% 20%, #1c1c20 0%, transparent 55%),
      linear-gradient(180deg, #0a0a0b 0%, #131316 60%, #08080a 100%);
    opacity: 1; animation: none;
  }
  .gate-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10,10,11,0.55) 0%,
      rgba(10,10,11,0.12) 30%,
      rgba(10,10,11,0.35) 70%,
      rgba(10,10,11,0.9) 100%
    );
  }

  .gate-top {
    position: absolute;
    top: clamp(1.5rem, 4vh, 2.5rem);
    left: 0; right: 0;
    padding-inline: clamp(1.25rem, 5vw, 3.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .gate-mark {
    font-weight: 700;
    letter-spacing: 0.2em;
    font-size: 0.95rem;
  }

  .gate-body {
    position: absolute;
    left: 0; right: 0;
    bottom: clamp(3rem, 9vh, 6.5rem);
    padding-inline: clamp(1.25rem, 5vw, 3.5rem);
    opacity: 0;
    transform: translateY(12px);
    animation: gate-rise 1.4s ease 1.1s forwards;
  }
  .gate-name {
    font-weight: 700;
    font-size: clamp(2.6rem, 8vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .gate-line {
    margin-top: 1rem;
    max-width: 40ch;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--bone);
    opacity: 0.78;
  }
  .gate-enter {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--hair);
    transition: border-color 0.4s ease;
  }
  .gate-arrow { transition: transform 0.4s cubic-bezier(0.2,0.6,0.2,1); }
  .gate:hover .gate-enter { border-color: var(--bone); }
  .gate:hover .gate-arrow { transform: translateX(6px); }

  @keyframes gate-fade { to { opacity: 1; } }
  @keyframes gate-rise { to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    .gate-media, .gate-body { opacity: 1; transform: none; animation: none; }
  }
</style>
