---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((work) => ({ params: { slug: work.slug } }));
}

const { slug } = Astro.params;
const work = await getEntry('works', slug!);
if (!work) return Astro.redirect('/404');
const { data } = work;
const { Content } = await work.render();
---

<Base title={data.title} description={data.logline}>
<div class="lightwrap">
  <main class="detail">
    <a href="/shorts/" class="meta back">← 이전으로</a>

    <div class="player wrap">
      <Player title={data.title} video={data.video} embed={data.embed} poster={data.poster} />
    </div>

    <header class="head wrap">
      <h1 class="head-title">{data.title}</h1>
      {data.logline && <p class="head-logline">{data.logline}</p>}

      <dl class="slate">
        <div><dt class="meta">Year</dt><dd class="meta">{data.year}</dd></div>
        {data.runtime && <div><dt class="meta">Runtime</dt><dd class="meta">{data.runtime}</dd></div>}
        {data.role && <div><dt class="meta">Role</dt><dd class="meta">{data.role}</dd></div>}
        {data.tools && data.tools.length > 0 && (
          <div><dt class="meta">Tools</dt><dd class="meta">{data.tools.join(' · ')}</dd></div>
        )}
      </dl>
    </header>

    <article class="note wrap">
      <Content />
    </article>

    {data.stills && data.stills.length > 0 && (
      <section class="stills wrap">
        {data.stills.map((src) => (
          <img class="still" src={src} alt={`${data.title} still`} loading="lazy" />
        ))}
      </section>
    )}
  </main>
</div>
</Base>


<style>
/* ── 상세 페이지: 라이트 테마 (목록과 동일) ── */
  .lightwrap {
    --surface: #e9e8e3;
    --ash: #6c6c70;
    --bone: #1a1a1d;
    --ember: #1a1a1d;
    --hair: rgba(20, 20, 25, 0.12);
    background: #f5f4f1;
    color: var(--bone);
    min-height: 100svh;
  }
  .lightwrap :global(.player-media.player-empty) {
    background: linear-gradient(180deg, #eceae4, #e0ded7);
  }
  .detail { padding-top: clamp(2rem, 6vh, 4rem); padding-bottom: clamp(5rem, 12vh, 9rem); }
  .back { display: inline-block; padding: 0 clamp(1.25rem, 5vw, 3.5rem); }
  .back:hover { color: var(--ember); }

  .player { margin-top: 2rem; }
  .head { margin-top: clamp(2.5rem, 5vh, 4rem); max-width: 60rem; }
  .head-title {
    font-family: var(--serif-display);
    font-weight: 800;
    font-size: clamp(1.4rem, 4.5vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .head-logline {
    margin-top: 1rem;
    font-style: italic;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--ash);
    max-width: 44ch;
  }

  .slate {
    margin-top: 2.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--hair);
  }
  .slate div { display: flex; flex-direction: column; gap: 0.45rem; }
  .slate dt { opacity: 0.6; }
  .slate dd { color: var(--bone); }

  .note {
    margin-top: clamp(3rem, 6vh, 4.5rem);
    max-width: 40rem;
    font-size: 1.18rem;
    line-height: 1.85;
  }
  .note :global(p) { margin-bottom: 1.4rem; }
  .note :global(p:last-child) { margin-bottom: 0; }

  .stills {
    margin-top: clamp(3.5rem, 7vh, 5.5rem);
    display: grid;
    gap: clamp(1rem, 2vw, 1.8rem);
  }
  .still { width: 100%; filter: grayscale(0.2) brightness(0.92); }
</style>
