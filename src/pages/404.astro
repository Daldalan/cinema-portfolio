---
import Base from '../layouts/Base.astro';
---
<Base title="찾을 수 없음">
  <main class="nf wrap">
    <p class="eyebrow">404</p>
    <h1 class="nf-title">이 길은 어둠 속에 있다</h1>
    <a href="/" class="meta nf-back">← 처음으로</a>
  </main>
</Base>

<style>
  .nf { min-height: 70svh; display: flex; flex-direction: column; justify-content: center; gap: 1.4rem; }
  .nf-title { font-family: var(--serif-display); font-weight: 300; font-size: clamp(2rem, 6vw, 4rem); }
  .nf-back { color: var(--ash); }
  .nf-back:hover { color: var(--ember); }
</style>
