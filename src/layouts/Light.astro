---
// 라이트 테마 공통 레이아웃: 상단 바(Shorts · Series) + 푸터.
import Base from './Base.astro';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  active?: 'shorts' | 'series';
}
const { title, description, active } = Astro.props;
const nav = [
  { key: 'shorts', label: 'Shorts', href: '/shorts/' },
  { key: 'series', label: 'Series', href: '/series/' },
];
---

<Base title={title} description={description}>
  <div class="lightwrap">
    <header class="topbar wrap">
      <a class="topbar-mark" href="/" aria-label="쇼릴로 이동">{site.directorLatin}</a>
      <nav class="topbar-nav" aria-label="섹션">
        {nav.map((n) => (
          <a class:list={['topbar-link', { 'is-active': n.key === active }]} href={n.href} aria-current={n.key === active ? 'page' : undefined}>
            {n.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer wrap">
      <p class="footer-name">{site.directorLatin}</p>
      <div class="footer-links">
        <a class="meta" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        {site.links.map((l) => (
          <a class="meta" href={l.href} target="_blank" rel="noopener">{l.label}</a>
        ))}
      </div>
      <p class="meta footer-credit">© {new Date().getFullYear()} {site.director}</p>
    </footer>
  </div>
</Base>

<style>
  .lightwrap {
    --surface: #e9e8e3;
    --ash: #6c6c70;
    --bone: #1a1a1d;
    --ember: #1a1a1d;
    --hair: rgba(20, 20, 25, 0.12);
    background: #f5f4f1;
    color: var(--bone);
    min-height: 100svh;
  }
  .lightwrap :global(.tile-frame) { transition: box-shadow 0.45s ease; }
  .lightwrap :global(.tile[href]:hover .tile-frame) { box-shadow: 0 18px 44px -22px rgba(20, 20, 25, 0.4); }
  .lightwrap :global(.tile-img.tile-empty) { background: linear-gradient(180deg, #eceae4, #e0ded7); }
  .lightwrap :global(.player-media.player-empty) { background: linear-gradient(180deg, #eceae4, #e0ded7); }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(1.4rem, 4vh, 2.2rem);
  }
  .topbar-mark { font-weight: 700; letter-spacing: 0.2em; font-size: 0.95rem; }
  .topbar-nav { display: flex; gap: clamp(1.1rem, 3vw, 2rem); }
  .topbar-link {
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--ash);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .topbar-link:hover { color: var(--bone); }
  .topbar-link.is-active { color: var(--bone); border-color: var(--bone); }

  /* ── 페이지 공통: 과장된 타이포 위계 ─────────────────────── */
  .lightwrap :global(.page-head) {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    margin-bottom: clamp(1.5rem, 3vh, 2.5rem);
  }
  .lightwrap :global(.page-title) {
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 11rem);
    line-height: 0.88;
    letter-spacing: -0.04em;
  }
  .lightwrap :global(.page-count) {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ash);
    padding-top: 1.2em;
  }
  .lightwrap :global(.page-empty) { color: var(--ash); padding-block: clamp(2rem, 6vh, 4rem); }

  .footer {
    padding-block: clamp(3rem, 8vh, 5.5rem);
    border-top: 1px solid var(--hair);
    display: flex; flex-wrap: wrap; align-items: baseline;
    gap: 1.5rem 2.5rem;
  }
  .footer-name {
    font-weight: 700; font-size: 1.4rem;
    letter-spacing: 0.2em; margin-right: auto;
  }
  .footer-links { display: flex; gap: 1.8rem; flex-wrap: wrap; }
  .footer-links a { transition: color 0.4s ease; }
  .footer-links a:hover { color: var(--bone); }
  .footer-credit { width: 100%; opacity: 0.7; }
</style>
