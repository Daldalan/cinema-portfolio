---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from './WorkCard.astro';
import { site } from '../site';
import { CATEGORIES, type Category } from '../content/config';

interface Props {
  category?: Category; // 없으면 전체
}
const { category } = Astro.props;

const all = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.localeCompare(a.data.date),
);
const works = category ? all.filter((w) => w.data.category === category) : all;
const pad = (n: number) => String(n).padStart(2, '0');
const tabs = [
  { label: 'All', href: '/works/', count: all.length, active: !category },
  ...CATEGORIES.map((c) => ({
    label: c,
    href: `/works/category/${c.toLowerCase()}/`,
    count: all.filter((w) => w.data.category === c).length,
    active: c === category,
  })),
];

const total = works.length;
// 4개 단위 지그재그(2+1, 1+2)에서 마지막 줄에 1개만 남으면(나머지 1 또는 3) 한 줄 전체를 쓰게 해 빈 칸을 없앤다.
const lastIsOrphan = total % 4 === 1 || total % 4 === 3;
---

<Base title={category ? `작품 · ${category}` : '작품'}>
  <div class="lightwrap">
  <header class="topbar wrap">
    <a class="topbar-mark" href="/">{site.directorLatin}</a>
    <a class="meta topbar-back" href="/">← 쇼릴</a>
  </header>

  <main>
    <section id="about" class="section section--lead wrap about">
      <p class="eyebrow section-eyebrow">About</p>
      <p class="about-body">
        스튜디오 달 에이아이는 생성형 AI를 통해 다양하고 재미있는 작업을 진행합니다.
        단편 영화/애니메이션, 인-게임 영상, 광고를 제작합니다.
      </p>
    </section>

    <section id="works" class="section wrap">
      <div class="works-head">
        <h1 class="works-title">Works</h1>
        <p class="works-count">({pad(total)})</p>
      </div>

      <nav class="works-tabs" aria-label="작품 카테고리">
        {tabs.map((t) => (
          <a class:list={['works-tab', { 'is-active': t.active }]} href={t.href} aria-current={t.active ? 'page' : undefined}>
            {t.label}<span class="works-tab-count">{pad(t.count)}</span>
          </a>
        ))}
      </nav>

      {total === 0 && <p class="works-empty">아직 등록된 작품이 없습니다.</p>}

      {total > 0 && <div class="works-grid">
        {works.map((work, i) => (
          <div class={`bento bento-${(i % 4) + 1}${lastIsOrphan && i === total - 1 ? ' bento-full' : ''}`}>
            <WorkCard
              href={`/works/${work.slug}/`}
              title={work.data.title}
              year={work.data.year}
              logline={work.data.logline}
              poster={work.data.poster}
              index={i}
            />
          </div>
        ))}
      </div>}
    </section>
  </main>

  <footer class="footer wrap">
    <p class="footer-name">{site.directorLatin}</p>
    <div class="footer-links">
      <a class="meta" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      {site.links.map((l) => (
        <a class="meta" href={l.href} target="_blank" rel="noopener">{l.label}</a>
      ))}
    </div>
    <p class="meta footer-credit">© {new Date().getFullYear()} {site.director}</p>
  </footer>
  </div>
</Base>

<style>
  /* ── 라이트 테마 ─────────────────────────────────────────── */
  .lightwrap {
    --surface: #e9e8e3;
    --ash: #6c6c70;
    --bone: #1a1a1d;
    --ember: #1a1a1d;
    --hair: rgba(20, 20, 25, 0.12);
    background: #f5f4f1;
    color: var(--bone);
    min-height: 100svh;
  }
  .lightwrap :global(.tile-frame) { transition: box-shadow 0.45s ease; }
  .lightwrap :global(.tile:hover .tile-frame) { box-shadow: 0 18px 44px -22px rgba(20, 20, 25, 0.4); }
  .lightwrap :global(.tile-img.tile-empty) { background: linear-gradient(180deg, #eceae4, #e0ded7); }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(1.4rem, 4vh, 2.2rem);
  }
  .topbar-mark { font-weight: 700; letter-spacing: 0.2em; font-size: 0.95rem; }
  .topbar-back { transition: color 0.3s ease; }
  .topbar-back:hover { color: var(--bone); }

  .section { padding-block: clamp(3.5rem, 9vh, 7rem); }
  .section--lead { padding-top: clamp(2rem, 5vh, 3.5rem); padding-bottom: clamp(1rem, 2vh, 2rem); }
  #works { padding-top: clamp(1rem, 2vh, 2rem); }
  .section-eyebrow { margin-bottom: 2rem; }

  /* ── 2026: 과장된 타이포 위계 ────────────────────────────── */
  .works-head {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    margin-bottom: clamp(1.5rem, 3vh, 2.5rem);
  }
  .works-title {
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 11rem);
    line-height: 0.88;
    letter-spacing: -0.04em;
  }
  .works-count {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ash);
    padding-top: 1.2em;
  }

  /* ── 카테고리 탭 ─────────────────────────────────────────── */
  .works-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.8rem;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--hair);
  }
  .works-tab {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--ash);
    padding-bottom: 0.25rem;
    border-bottom: 1px solid transparent;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .works-tab:hover { color: var(--bone); }
  .works-tab.is-active { color: var(--bone); border-color: var(--bone); }
  .works-tab-count {
    margin-left: 0.35em;
    font-size: 0.68rem;
    vertical-align: super;
    opacity: 0.7;
  }
  .works-empty { color: var(--ash); padding-block: clamp(2rem, 6vh, 4rem); }

  /* ── 2026: 벤토 그리드 (넓음/좁음 지그재그) ──────────────── */
  .works-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.4rem, 3vw, 2.5rem);
  }
  .bento-1 { grid-column: span 2; }
  .bento-2 { grid-column: span 1; }
  .bento-3 { grid-column: span 1; }
  .bento-4 { grid-column: span 2; }
  /* 좁은 칸은 세로형 프레임으로 리듬 주기 */
  .bento-2 :global(.tile-frame),
  .bento-3 :global(.tile-frame) { aspect-ratio: 3 / 3.05; }
  /* 줄에 혼자 남은 작품: 한 줄 전체 + 와이드 (위 규칙보다 뒤에 있어야 덮어씀) */
  .bento-full { grid-column: 1 / -1; }
  .bento-full :global(.tile-frame) { aspect-ratio: 21 / 9; }

  .about { max-width: 56rem; }
  .about-body {
    font-size: clamp(1.2rem, 2.3vw, 1.7rem);
    line-height: 1.55;
    color: var(--bone);
  }

  .footer {
    padding-block: clamp(3rem, 8vh, 5.5rem);
    border-top: 1px solid var(--hair);
    display: flex; flex-wrap: wrap; align-items: baseline;
    gap: 1.5rem 2.5rem;
  }
  .footer-name {
    font-weight: 700; font-size: 1.4rem;
    letter-spacing: 0.2em; margin-right: auto;
  }
  .footer-links { display: flex; gap: 1.8rem; flex-wrap: wrap; }
  .footer-links a { transition: color 0.4s ease; }
  .footer-links a:hover { color: var(--bone); }
  .footer-credit { width: 100%; opacity: 0.7; }

  @media (max-width: 720px) {
    .works-tabs { gap: 0.6rem 1.1rem; }
    .works-tab { font-size: 0.88rem; }
    .works-grid { grid-template-columns: 1fr; }
    .bento-1, .bento-2, .bento-3, .bento-4, .bento-full { grid-column: span 1; }
    .bento-2 :global(.tile-frame),
    .bento-3 :global(.tile-frame),
    .bento-full :global(.tile-frame) { aspect-ratio: 3 / 2; }
  }
</style>

