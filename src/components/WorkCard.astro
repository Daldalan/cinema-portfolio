---
interface Props {
  href?: string;   // 없으면 클릭되지 않는 카드 (예: 공개 예정 시리즈)
  title: string;
  year?: number;
  logline?: string;
  poster?: string;
  badge?: string;  // 이미지 위 라벨. 예: 'Coming soon'
  index: number;
}
const { href, title, year, logline, poster, badge, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const Tag = href ? 'a' : 'div';
---

<Tag class="tile" href={href}>
  <div class="tile-frame">
    {poster ? (
      <img class="tile-img" src={poster} alt={title} loading="lazy" />
    ) : (
      <div class="tile-img tile-empty" aria-hidden="true">{!badge && <span>{num}</span>}</div>
    )}
    {badge && <span class="tile-badge">{badge}</span>}
  </div>
  <div class="tile-meta">
    <h3 class="tile-title">{title}</h3>
    <p class="tile-sub">
      {year && <span class="tile-year">{year}</span>}
      {logline && <span class="tile-line">{logline}</span>}
    </p>
  </div>
</Tag>

<style>
  .tile { display: block; }

  .tile-frame {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--surface);
  }
  .tile-img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: brightness(0.9);
    transition: transform 1.1s cubic-bezier(0.2,0.6,0.2,1), filter 0.7s ease;
  }
  a.tile:hover .tile-img,
  a.tile:focus-visible .tile-img {
    transform: scale(1.04);
    filter: brightness(1.04);
  }

  .tile-empty {
    display: grid; place-items: center;
    background:
      radial-gradient(120% 100% at 50% 0%, #1e1e22 0%, transparent 60%),
      linear-gradient(180deg, #151517, #0c0c0e);
  }
  .tile-empty span {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--ash);
    opacity: 0.4;
  }

  .tile-meta {
    padding-top: 1rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .tile-title {
    font-weight: 600;
    font-size: clamp(1.1rem, 1.7vw, 1.45rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
    transition: opacity 0.3s ease;
  }
  .tile[href]:hover .tile-title { opacity: 0.65; }

  .tile-badge {
    position: absolute;
    left: 1rem; top: 1rem;
    padding: 0.35rem 0.7rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f5f4f1;
    background: rgba(20, 20, 25, 0.82);
  }

  .tile-sub {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    text-align: right;
  }
  .tile-year {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ash);
  }
  .tile-line {
    font-size: 0.82rem;
    color: var(--ash);
    opacity: 0.8;
    max-width: 22ch;
  }

  @media (max-width: 620px) {
    .tile-meta { flex-direction: column; gap: 0.35rem; }
    .tile-sub { align-items: flex-start; text-align: left; }
  }
</style>
